@model Absence
@{ ViewData["Title"] = "Delete Absence"; }
<h1>Delete Absence</h1>
<p>Are you sure you want to delete this absence record?</p>
<dl>
    <dt>Student</dt><dd>@Model.Student?.FullName</dd>
    <dt>Class</dt><dd>@Model.Class?.CourseCode @Model.Class?.Section</dd>
    <dt>Date</dt><dd>@Model.AbsenceDate.ToString("yyyy-MM-dd")</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit">Delete</button> <a asp-action="Index">Cancel</a>
</form>