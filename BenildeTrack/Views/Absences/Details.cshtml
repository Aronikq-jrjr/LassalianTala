@model Absence
@{ ViewData["Title"] = "Absence Details"; }
<h1>Absence Details</h1>
<dl>
    <dt>Student</dt><dd>@Model.Student?.FullName</dd>
    <dt>Class</dt><dd>@Model.Class?.CourseCode @Model.Class?.Section - @Model.Class?.CourseName</dd>
    <dt>Date</dt><dd>@Model.AbsenceDate.ToString("yyyy-MM-dd")</dd>
    <dt>Excuse Document</dt>
    <dd>@(Model.ExcuseDocument == null ? "None" : Model.ExcuseDocument.DocumentType + " (" + Model.ExcuseDocument.Status + ")")</dd>
</dl>
@if (User.IsInRole(AppRoles.Professor))
{
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a><text> | </text>
}
<a asp-action="Index">Back to list</a>