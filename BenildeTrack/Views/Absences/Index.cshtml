@model IEnumerable<Absence>
@{ ViewData["Title"] = "Absences"; }
<h1>Absences</h1>
@if (User.IsInRole(AppRoles.Professor))
{
    <p><a asp-action="Create">Record Absence</a></p>
}
<table border="1" cellpadding="4">
    <thead><tr><th>Student</th><th>Class</th><th>Date</th><th>Excuse Document</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Student?.FullName</td>
            <td>@item.Class?.CourseCode @item.Class?.Section</td>
            <td>@item.AbsenceDate.ToString("yyyy-MM-dd")</td>
            <td>@(item.ExcuseDocument == null ? "None" : item.ExcuseDocument.DocumentType + " (" + item.ExcuseDocument.Status + ")")</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                @if (User.IsInRole(AppRoles.Professor))
                {
                    <text> | </text><a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <text> | </text><a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>