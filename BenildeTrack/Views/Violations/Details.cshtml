@model Violation
@{ ViewData["Title"] = "Violation Details"; }
<h1>Violation Details</h1>
<dl>
    <dt>Student</dt><dd>@Model.Student?.FullName</dd>
    <dt>Offense</dt><dd>@Model.Offense</dd>
    <dt>Description</dt><dd>@Model.Description</dd>
    <dt>Date</dt><dd>@Model.ViolationDate.ToString("yyyy-MM-dd")</dd>
    <dt>Status</dt><dd>@Model.Status</dd>
</dl>
@if (User.IsInRole(AppRoles.Administrator))
{
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a><text> | </text>
}
<a asp-action="Index">Back to list</a>