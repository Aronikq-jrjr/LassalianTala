@model IEnumerable<Violation>
@{ ViewData["Title"] = "Violations"; }
<h1>Violations</h1>
@if (User.IsInRole(AppRoles.Administrator))
{
    <p><a asp-action="Create">Create New</a></p>
}
<table border="1" cellpadding="4">
    <thead><tr><th>Student</th><th>Offense</th><th>Date</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Student?.FullName</td>
            <td>@item.Offense</td>
            <td>@item.ViolationDate.ToString("yyyy-MM-dd")</td>
            <td>@item.Status</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                @if (User.IsInRole(AppRoles.Administrator))
                {
                    <text> | </text><a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <text> | </text><a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>