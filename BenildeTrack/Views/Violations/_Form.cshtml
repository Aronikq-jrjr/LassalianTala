@model Violation
<div asp-validation-summary="All" style="color:red"></div>
<p><label asp-for="StudentId"></label><br />
   <select asp-for="StudentId" asp-items="@((SelectList)ViewBag.Students)"><option value="">-- select --</option></select>
   <span asp-validation-for="StudentId" style="color:red"></span></p>
<p><label asp-for="Offense"></label><br /><input asp-for="Offense" /><span asp-validation-for="Offense" style="color:red"></span></p>
<p><label asp-for="Description"></label><br /><textarea asp-for="Description" rows="4" cols="40"></textarea><span asp-validation-for="Description" style="color:red"></span></p>
<p><label asp-for="ViolationDate"></label><br /><input asp-for="ViolationDate" type="date" /><span asp-validation-for="ViolationDate" style="color:red"></span></p>
<p><label asp-for="Status"></label><br /><select asp-for="Status" asp-items="@((SelectList)ViewBag.Statuses)"></select></p>