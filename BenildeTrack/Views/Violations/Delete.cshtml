@model Violation
@{ ViewData["Title"] = "Delete Violation"; }
<h1>Delete Violation</h1>
<p>Are you sure you want to delete this violation?</p>
<dl>
    <dt>Student</dt><dd>@Model.Student?.FullName</dd>
    <dt>Offense</dt><dd>@Model.Offense</dd>
    <dt>Date</dt><dd>@Model.ViolationDate.ToString("yyyy-MM-dd")</dd>
    <dt>Status</dt><dd>@Model.Status</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit">Delete</button> <a asp-action="Index">Cancel</a>
</form>