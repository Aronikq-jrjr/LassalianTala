@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<h1 class="page-title">Profile</h1>

<div class="panel col-lg-6">
    <dl class="row mb-3">
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Role</dt><dd class="col-sm-9">@Model.Role</dd>
    </dl>

    <form method="post" asp-action="Update">
        <label class="form-label">Full name</label>
        <input name="fullName" value="@Model.FullName" class="form-control mb-3" maxlength="100" required />
        <button class="btn btn-primary">Save</button>
    </form>

    <hr />
    <a href="~/Identity/Account/Manage">Change email or password</a>
</div>
