@model StudentDetailViewModel
@{
    ViewData["Title"] = "Manage student";
    var id = Model.Student.Id;
}

<h1 class="page-title">@Model.Student.DisplayName</h1>
<p class="text-muted">@Model.Student.Email</p>

@* ---------- Courses ---------- *@
<div class="panel">
    <h2 class="panel-title">Courses</h2>
    @if (Model.Enrolled.Any())
    {
        <p>@string.Join(", ", Model.Enrolled.Select(c => c.Code))</p>
    }
    else
    {
        <p class="text-muted">Not enrolled in any course.</p>
    }

    @if (Model.NotEnrolled.Any())
    {
        <form method="post" asp-action="Enroll" asp-route-id="@id" class="d-flex gap-2">
            <select name="courseId" class="form-select" asp-items="@(new SelectList(Model.NotEnrolled, "Id", "Code"))"></select>
            <button class="btn btn-primary">Enroll</button>
        </form>
    }
</div>

@* ---------- Violations ---------- *@
<div class="panel">
    <h2 class="panel-title">Violations</h2>

    @if (Model.Violations.Any())
    {
        <table class="table">
            <thead><tr><th>Date</th><th>Violation</th><th>Details</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var v in Model.Violations)
                {
                    <tr>
                        <td>@v.Date.ToString("MMM d, yyyy")</td>
                        <td>@v.Title</td>
                        <td>@v.Description</td>
                        <td>@(v.IsResolved ? "Resolved" : "Open")</td>
                        <td class="text-end">
                            @if (!v.IsResolved)
                            {
                                <form method="post" asp-action="ResolveViolation" asp-route-id="@id">
                                    <input type="hidden" name="violationId" value="@v.Id" />
                                    <button class="btn btn-sm btn-outline-success">Resolve</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <form method="post" asp-action="AddViolation" asp-route-id="@id" class="row g-2">
        <div class="col-md-4"><input name="title" class="form-control" placeholder="Violation title" required /></div>
        <div class="col-md-6"><input name="description" class="form-control" placeholder="What happened" /></div>
        <div class="col-md-2"><button class="btn btn-primary w-100">Add</button></div>
    </form>
</div>

@* ---------- Objectives and clearances ---------- *@
<div class="panel">
    <h2 class="panel-title">Objectives and clearances</h2>
    <table class="table mb-0">
        <thead><tr><th>Type</th><th>Name</th><th>Guide</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var row in Model.Requirements)
            {
                <tr>
                    <td>@row.Requirement.Kind</td>
                    <td>@row.Requirement.Name</td>
                    <td>@row.Requirement.Guide</td>
                    <td>@(row.IsDone ? "Done" : "Missing")</td>
                    <td class="text-end">
                        <form method="post" asp-action="SetRequirement" asp-route-id="@id">
                            <input type="hidden" name="requirementId" value="@row.Requirement.Id" />
                            @if (row.IsDone)
                            {
                                <button name="done" value="false" class="btn btn-sm btn-outline-secondary">Undo</button>
                            }
                            else
                            {
                                <button name="done" value="true" class="btn btn-sm btn-outline-success">Mark done</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-controller="Dashboard" asp-action="Index">Back to students</a>
