@model List<HandbookSection>
@{
    ViewData["Title"] = "Handbook";
    string? query = ViewBag.Query;
}

<h1 class="page-title">Handbook</h1>
<p class="text-muted">Search for a rule. This finds matching sections, it is not an official ruling.</p>

<form method="get" asp-action="Index" class="d-flex gap-2 mb-4">
    <input name="q" value="@query" class="form-control" placeholder="Try: shouting in class" />
    <button class="btn btn-primary">Search</button>
</form>

@if (!string.IsNullOrWhiteSpace(query) && !Model.Any())
{
    <p>No matching sections. Try different words.</p>
}

@foreach (var s in Model)
{
    <div class="panel">
        <h2 class="panel-title">@s.Number - @s.Title</h2>
        <p class="mb-0">@s.Text</p>
    </div>
}
