@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<h1>Dashboard</h1>
<p>Welcome, @Model.FullName (@Model.Role)</p>

@if (Model.Role == AppRoles.Administrator)
{
    <ul>
        <li>Students: @Model.StudentCount</li>
        <li>Professors: @Model.ProfessorCount</li>
        <li>Classes: @Model.ClassCount</li>
        <li>Unresolved violations: @Model.AllUnresolvedViolations</li>
    </ul>
    <h3>Latest violations</h3>
    <table border="1" cellpadding="4">
        <thead><tr><th>Student</th><th>Offense</th><th>Date</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var v in Model.RecentViolations)
        {
            <tr><td>@v.Student?.FullName</td><td>@v.Offense</td><td>@v.ViolationDate.ToString("yyyy-MM-dd")</td><td>@v.Status</td></tr>
        }
        </tbody>
    </table>
}
else if (Model.Role == AppRoles.Professor)
{
    <ul>
        <li>Classes you teach: @Model.ClassesTaught</li>
        <li>Absences you recorded: @Model.AbsencesRecorded</li>
        <li>Documents waiting for your review: @Model.DocumentsToReview</li>
    </ul>
    <h3>Pending documents</h3>
    <table border="1" cellpadding="4">
        <thead><tr><th>Student</th><th>Type</th><th>Submitted</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in Model.RecentDocuments)
        {
            <tr>
                <td>@d.Student?.FullName</td><td>@d.DocumentType</td><td>@d.DateSubmitted.ToString("yyyy-MM-dd HH:mm")</td>
                <td><a asp-controller="ExcuseDocuments" asp-action="Review" asp-route-id="@d.Id">Review</a></td>
            </tr>
        }
        </tbody>
    </table>
}
else if (Model.Role == AppRoles.Student)
{
    <ul>
        <li>Violations: @Model.TotalViolations (unresolved: @Model.UnresolvedViolations)</li>
        <li>Absences: @Model.TotalAbsences</li>
        <li>Pending excuse documents: @Model.PendingDocuments</li>
    </ul>

    <h3>Latest violations</h3>
    <table border="1" cellpadding="4">
        <thead><tr><th>Offense</th><th>Date</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var v in Model.RecentViolations)
        {
            <tr><td>@v.Offense</td><td>@v.ViolationDate.ToString("yyyy-MM-dd")</td><td>@v.Status</td></tr>
        }
        </tbody>
    </table>

    <h3>Latest absences</h3>
    <table border="1" cellpadding="4">
        <thead><tr><th>Class</th><th>Date</th></tr></thead>
        <tbody>
        @foreach (var a in Model.RecentAbsences)
        {
            <tr><td>@a.Class?.CourseCode @a.Class?.Section</td><td>@a.AbsenceDate.ToString("yyyy-MM-dd")</td></tr>
        }
        </tbody>
    </table>

    <h3>Excuse document status</h3>
    <table border="1" cellpadding="4">
        <thead><tr><th>Type</th><th>Professor</th><th>Submitted</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var d in Model.RecentDocuments)
        {
            <tr><td>@d.DocumentType</td><td>@d.Professor?.FullName</td><td>@d.DateSubmitted.ToString("yyyy-MM-dd")</td><td>@d.Status</td></tr>
        }
        </tbody>
    </table>
}