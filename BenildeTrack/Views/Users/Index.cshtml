@model IEnumerable<UserListItem>
@{ ViewData["Title"] = "User Accounts"; }
<h1>@(string.IsNullOrEmpty((string?)ViewBag.RoleFilter) ? "User Accounts" : ViewBag.RoleFilter + "s")</h1>
<p><a asp-action="Create" asp-route-role="@ViewBag.RoleFilter">Create New</a></p>
<form method="get">
    Role: <select name="role" asp-items="@((SelectList)ViewBag.Roles)"><option value="">All</option></select>
    <button type="submit">Filter</button>
</form>
<table border="1" cellpadding="4">
    <thead><tr><th>Full Name</th><th>Email</th><th>Role</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FullName</td>
            <td>@item.Email</td>
            <td>@item.Role</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>