@model UserListItem
@{ ViewData["Title"] = "User Details"; }
<h1>User Details</h1>
<dl>
    <dt>Full Name</dt><dd>@Model.FullName</dd>
    <dt>Email</dt><dd>@Model.Email</dd>
    <dt>Role</dt><dd>@Model.Role</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> | <a asp-action="Index">Back to list</a>