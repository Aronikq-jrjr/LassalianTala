@model UserCreateViewModel
@{ ViewData["Title"] = "Create User"; }
<h1>Create User</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" style="color:red"></div>
    <p><label asp-for="FullName"></label><br /><input asp-for="FullName" /><span asp-validation-for="FullName" style="color:red"></span></p>
    <p><label asp-for="Email"></label><br /><input asp-for="Email" /><span asp-validation-for="Email" style="color:red"></span></p>
    <p><label asp-for="Password"></label><br /><input asp-for="Password" /><span asp-validation-for="Password" style="color:red"></span></p>
    <p><label asp-for="Role"></label><br /><select asp-for="Role" asp-items="@((SelectList)ViewBag.Roles)"></select></p>
    <button type="submit">Create</button> <a asp-action="Index">Cancel</a>
</form>