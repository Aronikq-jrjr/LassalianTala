@model CampusViewModel
@{
    ViewData["Title"] = "Campus";
}

<h1 class="page-title">Campus</h1>

<div class="panel">
    <h2 class="panel-title">Current violations</h2>
    @if (!Model.Violations.Any())
    {
        <p class="text-muted mb-0">No open violations.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead><tr><th>Date</th><th>Violation</th><th>Details</th></tr></thead>
            <tbody>
                @foreach (var v in Model.Violations)
                {
                    <tr>
                        <td>@v.Date.ToString("MMM d, yyyy")</td>
                        <td>@v.Title</td>
                        <td>@v.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="panel">
    <h2 class="panel-title">Missing clearances</h2>
    @if (!Model.MissingClearances.Any())
    {
        <p class="text-muted mb-0">Nothing missing.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead><tr><th>Clearance</th><th>Guide</th></tr></thead>
            <tbody>
                @foreach (var r in Model.MissingClearances)
                {
                    <tr><td>@r.Name</td><td>@r.Guide</td></tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="panel">
    <h2 class="panel-title">Campus objectives: missing</h2>
    @if (!Model.MissingObjectives.Any())
    {
        <p class="text-muted mb-0">All objectives complete.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead><tr><th>Objective</th><th>Guide</th></tr></thead>
            <tbody>
                @foreach (var r in Model.MissingObjectives)
                {
                    <tr><td>@r.Name</td><td>@r.Guide</td></tr>
                }
            </tbody>
        </table>
    }
</div>
