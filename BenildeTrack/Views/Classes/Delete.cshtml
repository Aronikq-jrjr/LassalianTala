@model SchoolClass
@{ ViewData["Title"] = "Delete Class"; }
<h1>Delete Class</h1>
<p>Are you sure you want to delete this class?</p>
<dl>
    <dt>Course Code</dt><dd>@Model.CourseCode</dd>
    <dt>Course Name</dt><dd>@Model.CourseName</dd>
    <dt>Section</dt><dd>@Model.Section</dd>
    <dt>Professor</dt><dd>@(Model.Professor?.FullName ?? "(none)")</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit">Delete</button> <a asp-action="Index">Cancel</a>
</form>