@{
    // Which sidebar item is highlighted, based on the current controller.
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(params string[] controllers) => controllers.Contains(current) ? "active" : "";

    var navDashboard = Active("Dashboard", "Campus", "Attendance", "Students");
    var navHandbook = Active("Handbook");
    var navProfile = Active("Profile");

    bool signedIn = User.Identity?.IsAuthenticated == true;
    string role = User.IsInRole(AppRoles.Admin) ? "Admin" : User.IsInRole(AppRoles.Teacher) ? "Teacher" : "Student";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @AppInfo.Name</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (signedIn)
{
    @* Logged in: sidebar on the left, page content on the right. *@
    <div class="app">
        <aside class="sidebar">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">@AppInfo.Name</a>

            <nav class="nav-list">
                <a class="nav-item @navDashboard" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a class="nav-item @navHandbook" asp-controller="Handbook" asp-action="Index">Handbook</a>
                <a class="nav-item @navProfile" asp-controller="Profile" asp-action="Index">Profile</a>
            </nav>

            <div class="sidebar-footer">
                <div class="small text-truncate">@User.Identity?.Name</div>
                <div class="small text-muted mb-2">@role</div>
                <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Log out</button>
                </form>
            </div>
        </aside>

        <main class="content">
            @* One place for the messages controllers leave in TempData. *@
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @RenderBody()
        </main>
    </div>
}
else
{
    @* Logged out: login and register pages show in a small centered card. *@
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="auth-brand">@AppInfo.Name</div>
            @RenderBody()
        </div>
    </div>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
