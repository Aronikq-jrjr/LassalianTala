@model IEnumerable<ExcuseDocument>
@{ ViewData["Title"] = "Excuse Documents"; }
<h1>Excuse Documents</h1>
@if (User.IsInRole(AppRoles.Student))
{
    <p><a asp-action="Create">Upload Document</a></p>
}
<table border="1" cellpadding="4">
    <thead>
        <tr><th>Student</th><th>Professor</th><th>Type</th><th>Benire Dates</th><th>Submitted</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Student?.FullName</td>
            <td>@item.Professor?.FullName</td>
            <td>@item.DocumentType</td>
            <td>
                @if (item.BenireStartDate != null && item.BenireEndDate != null)
                {
                    @($"{item.BenireStartDate:yyyy-MM-dd} to {item.BenireEndDate:yyyy-MM-dd}")
                }
            </td>
            <td>@item.DateSubmitted.ToString("yyyy-MM-dd HH:mm")</td>
            <td>@item.Status</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Download" asp-route-id="@item.Id" target="_blank">View file</a>
                @if (User.IsInRole(AppRoles.Professor))
                {
                    <text> | </text><a asp-action="Review" asp-route-id="@item.Id">@(item.DocumentType == ExcuseDocument.BenireType ? "Acknowledge" : "Review")</a>
                }
                @if (User.IsInRole(AppRoles.Student) && item.Status == "Pending")
                {
                    <text> | </text><a asp-action="Delete" asp-route-id="@item.Id">Withdraw</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>