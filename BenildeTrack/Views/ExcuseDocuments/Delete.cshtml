@model ExcuseDocument
@{ ViewData["Title"] = "Withdraw Document"; }
<h1>Withdraw Document</h1>
<p>Are you sure you want to withdraw this document? The uploaded file will be deleted.</p>
<dl>
    <dt>Type</dt><dd>@Model.DocumentType</dd>
    <dt>Professor</dt><dd>@Model.Professor?.FullName</dd>
    <dt>File</dt><dd>@Model.OriginalFileName</dd>
    <dt>Submitted</dt><dd>@Model.DateSubmitted.ToString("yyyy-MM-dd HH:mm")</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit">Withdraw</button> <a asp-action="Index">Cancel</a>
</form>