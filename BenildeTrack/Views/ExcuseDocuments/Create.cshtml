@model ExcuseUploadViewModel
@{ ViewData["Title"] = "Upload Document"; }
<h1>Upload Excuse Document</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" style="color:red"></div>
    <p><label asp-for="ProfessorId"></label><br />
       <select asp-for="ProfessorId" asp-items="@((SelectList)ViewBag.Professors)"><option value="">-- select --</option></select>
       <span asp-validation-for="ProfessorId" style="color:red"></span></p>
    <p><label asp-for="DocumentType"></label><br />
       <select asp-for="DocumentType" asp-items="@((SelectList)ViewBag.Types)"></select></p>
    <p>For Benire letters only:</p>
    <p><label asp-for="BenireStartDate"></label><br /><input asp-for="BenireStartDate" type="date" /><span asp-validation-for="BenireStartDate" style="color:red"></span></p>
    <p><label asp-for="BenireEndDate"></label><br /><input asp-for="BenireEndDate" type="date" /><span asp-validation-for="BenireEndDate" style="color:red"></span></p>
    <p><label asp-for="File"></label><br /><input asp-for="File" type="file" accept=".pdf,.jpg,.jpeg,.png" /><span asp-validation-for="File" style="color:red"></span></p>
    <button type="submit">Upload</button> <a asp-action="Index">Cancel</a>
</form>