@model ExcuseDocument
@{ ViewData["Title"] = "Excuse Document"; }
<h1>Excuse Document</h1>
<dl>
    <dt>Student</dt><dd>@Model.Student?.FullName</dd>
    <dt>Professor</dt><dd>@Model.Professor?.FullName</dd>
    <dt>Type</dt><dd>@Model.DocumentType</dd>
    @if (Model.BenireStartDate != null && Model.BenireEndDate != null)
    {
        <dt>Benire Dates</dt><dd>@($"{Model.BenireStartDate:yyyy-MM-dd} to {Model.BenireEndDate:yyyy-MM-dd}")</dd>
    }
    <dt>File</dt><dd>@Model.OriginalFileName (<a asp-action="Download" asp-route-id="@Model.Id" target="_blank">view</a>)</dd>
    <dt>Submitted</dt><dd>@Model.DateSubmitted.ToString("yyyy-MM-dd HH:mm")</dd>
    <dt>Status</dt><dd>@Model.Status</dd>
    @if (Model.SignedAt != null)
    {
        <dt>Acknowledged by @Model.Professor?.FullName at</dt><dd>@Model.SignedAt.Value.ToString("yyyy-MM-dd HH:mm")</dd>
    }
    <dt>Remarks</dt><dd>@Model.Remarks</dd>
</dl>
@if (User.IsInRole(AppRoles.Professor))
{
    <a asp-action="Review" asp-route-id="@Model.Id">@(Model.DocumentType == ExcuseDocument.BenireType ? "Acknowledge" : "Review")</a><text> | </text>
}
<a asp-action="Index">Back to list</a>