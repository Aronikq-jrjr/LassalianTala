@model ReviewViewModel
@{
    ViewData["Title"] = "Review Document";
    var doc = (ExcuseDocument)ViewBag.Document;
    var isBenire = doc.DocumentType == ExcuseDocument.BenireType;
}
<h1>@(isBenire ? "Acknowledge Benire Letter" : "Review Document")</h1>
<dl>
    <dt>Student</dt><dd>@doc.Student?.FullName</dd>
    <dt>Type</dt><dd>@doc.DocumentType</dd>
    @if (doc.BenireStartDate != null && doc.BenireEndDate != null)
    {
        <dt>Benire Dates</dt><dd>@($"{doc.BenireStartDate:yyyy-MM-dd} to {doc.BenireEndDate:yyyy-MM-dd}")</dd>
    }
    <dt>File</dt><dd><a asp-action="Download" asp-route-id="@doc.Id" target="_blank">@doc.OriginalFileName</a></dd>
    <dt>Current status</dt><dd>@doc.Status</dd>
</dl>
@if (isBenire)
{
    <p>Acknowledging records that you have seen this letter and know the student will be absent. It is not an approval.</p>
}
<form asp-action="Review" method="post">
    <div asp-validation-summary="All" style="color:red"></div>
    <input type="hidden" asp-for="Id" />
    <p><label asp-for="Decision"></label><br />
       <select asp-for="Decision" asp-items="@((SelectList)ViewBag.Decisions)"></select></p>
    <p><label asp-for="Remarks"></label><br /><textarea asp-for="Remarks" rows="3" cols="40"></textarea><span asp-validation-for="Remarks" style="color:red"></span></p>
    <button type="submit">Save</button> <a asp-action="Index">Cancel</a>
</form>